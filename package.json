{
  "name": "powerflo-card",
  "version": "0.5.0",
  "description": "A transparent, read-only Home Assistant card for solar, battery, grid and load power flow.",
  "type": "module",
  "main": "dist/powerflo-card.js",
  "files": [
    "dist/powerflo-card.js",
    "dist/inverter-reference.png",
    "README.md",
    "hacs.json",
    "waveshare-commissioning-guide.html",
    "waveshare-readonly.yaml",
    "secrets.example.yaml"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "build:demo": "node scripts/export-demo.js",
    "dev": "rollup --config rollup.config.js --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run test:coverage && npm run build && npm run build:demo"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "rollup": "4.64.5",
    "vitest": "5.0.3"
  }
}
